{
  "url": "http://localhost:4412/lamplit/app/#/runs",
  "viewport": "desktop",
  "ready": "[data-ready]",
  "rects": {
    "timeline": "[data-panel=\"timeline\"]",
    "nowLine": ".tl-now",
    "barRunning": "[data-bar=\"52318\"]",
    "laneResize": "[data-lane=\"resize-images\"]",
    "callout": "[data-callout]",
    "calloutOpen": "[data-callout-open]",
    "runHead": ".run-head",
    "runTitle": ".run-head h1",
    "status": "[data-replay-status]",
    "replayFromStep": "[data-action=\"replay-from-step\"]",
    "waterfall": "[data-panel=\"waterfall\"]",
    "outcome": "[data-outcome]",
    "stepWriteLedger": "[data-step=\"write-ledger\"]",
    "steps": "[data-step]*",
    "logs": "[data-panel=\"logs\"]",
    "newSchedule": "[data-panel=\"new-schedule\"]",
    "scheduleField": ".big-field",
    "scheduleResult": "[data-panel=\"schedule-result\"]",
    "cron": "[data-cron]",
    "nextRuns": "[data-next-runs]",
    "scheduleSummary": "[data-panel=\"schedule-summary\"]"
  },
  "steps": [
    { "rects": "runs" },
    { "capture": "runs", "rect": [236, 120, 1204, 470], "scale": 3 },
    { "click": "[data-bar=\"52318\"]" },
    { "rects": "callout" },
    { "capture": "callout", "rect": [236, 120, 1204, 470], "scale": 3 },
    { "click": "[data-callout-open]" },
    { "tap": [700, 860] },
    { "rects": "fanout" },
    { "capture": "fanout", "rect": [236, 60, 1192, 640], "scale": 3 },

    { "eval": "location.hash = '#/schedules'" },
    { "rects": "schedule" },
    { "click": "[data-field=\"schedule\"]" },
    { "capture": "sched-00", "around": "[data-panel=\"new-schedule\"]", "pad": 0, "scale": 2 },
    { "type": "[data-field=\"schedule\"]", "text": "every weekday at 9am", "capture": "sched", "around": "[data-panel=\"new-schedule\"]", "pad": 0, "scale": 2 },
    { "rects": "typed" },

    { "eval": "location.hash = '#/runs/4812'" },
    { "rects": "failed" },
    { "capture": "failed", "rect": [236, 60, 1192, 470], "scale": 3 },
    { "click": "[data-action=\"replay-from-step\"]" },
    { "rects": "queued" },
    { "capture": "queued", "rect": [236, 60, 1192, 470], "scale": 3 },
    { "eval": "lamplit.replay('running')" },
    { "rects": "running" },
    { "capture": "running", "rect": [236, 60, 1192, 470], "scale": 3 },
    { "eval": "lamplit.replay('succeeded')" },
    { "rects": "succeeded" },
    { "capture": "succeeded", "rect": [236, 60, 1192, 470], "scale": 3 }
  ]
}
